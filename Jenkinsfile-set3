
pipeline {
    agent any

    stages {
        stage('Check Kubernetes') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" get nodes'
            }
        }

        stage('Create Pod from YAML') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" apply -f pod.yaml'
            }
        }

        stage('Verify Pod') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" wait --for=condition=Ready pod/exam-pod --timeout=120s'
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" get pod exam-pod'
            }
        }
    }
}
