
pipeline {
    agent any

    stages {
        stage('Create PVC and Pod') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" apply -f set9-pvc-pod.yaml'
            }
        }

        stage('Verify PVC') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" get pvc set9-pvc'
            }
        }

        stage('Verify Pod and Mount') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" get pod set9-pod'
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" describe pod set9-pod'
            }
        }
    }
}
