
pipeline {
    agent any

    stages {
        stage('Checkout GitHub Code') {
            steps {
                checkout scm
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" apply -f set11-deployment.yaml'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" rollout status deployment/set11-web'
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" get deployment set11-web'
            }
        }
    }

    triggers {
        pollSCM('H/2 * * * *')
    }
}
