pipeline {
    agent any

    stages {
        stage('Check Kubernetes') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" get nodes'
            }
        }

        stage('Deploy Web Application') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" apply -f set4-deployment.yaml'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" rollout status deployment/set4-web'
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" get deployment set4-web'
                bat 'kubectl --kubeconfig="C:\\Users\\LENOVO\\.kube\\config" get pods -l app=set4-web'
            }
        }
    }
}